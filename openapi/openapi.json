{
  "components": {
    "schemas": {
      "Agent": {
        "properties": {
          "harness": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "mcp_servers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "model": {
            "type": "string"
          }
        },
        "required": [
          "harness",
          "model",
          "instructions",
          "mcp_servers"
        ],
        "type": "object"
      },
      "ChecksState": {
        "description": "Derived state of the check runs on the PR's head commit.",
        "enum": [
          "pending",
          "passing",
          "failing"
        ],
        "type": "string"
      },
      "ClaimRequest": {
        "properties": {
          "environment_types": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "harnesses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ClaimResponse": {
        "properties": {
          "event_fidelity": {
            "$ref": "#/components/schemas/EventFidelity",
            "description": "The event-fidelity policy of the host's workspace. Under `redacted`\nthe host must strip all content strings from session events before\nreporting them."
          },
          "session": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Session"
              }
            ],
            "description": "The claimed session, or null if there is no pending work.",
            "nullable": true
          }
        },
        "required": [
          "event_fidelity"
        ],
        "type": "object"
      },
      "CreateRoutineRequest": {
        "description": "Create a routine. The schedule is a flat `cron` + `timezone` pair — chosen\nfor request/response symmetry with the flat [`Routine`] response, rather\nthan the design doc's illustrative nested `schedule` object.",
        "properties": {
          "cron": {
            "description": "Standard 5-field cron expression.",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/SessionSpec"
          },
          "timezone": {
            "description": "IANA timezone name (e.g. \"America/New_York\") the cron is interpreted in.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "cron",
          "timezone",
          "spec"
        ],
        "type": "object"
      },
      "CreateSessionRequest": {
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/Agent"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "input": {
            "type": "string"
          }
        },
        "required": [
          "agent",
          "environment",
          "input"
        ],
        "type": "object"
      },
      "EnrollHostRequest": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "EnrollHostResponse": {
        "properties": {
          "host": {
            "$ref": "#/components/schemas/Host"
          },
          "token": {
            "description": "The bearer token for this host. Shown exactly once; store it safely.",
            "type": "string"
          }
        },
        "required": [
          "host",
          "token"
        ],
        "type": "object"
      },
      "EnrollmentToken": {
        "description": "A reusable enrollment token. Carries no secret: only the SHA-256 hash of\nthe `venroll_` secret is stored, and the secret itself is returned once,\nat mint.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "max_uses": {
            "description": "Maximum number of exchanges; `None` = unlimited.",
            "format": "int64",
            "nullable": true,
            "type": "integer"
          },
          "revoked_at": {
            "description": "Set when the token was revoked; a revoked token can no longer be\nexchanged.",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "uses": {
            "description": "How many exchanges have succeeded so far.",
            "format": "int64",
            "type": "integer"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/WorkspaceId",
            "description": "The workspace every host enrolled through this token lands in."
          }
        },
        "required": [
          "id",
          "workspace_id",
          "uses",
          "created_at"
        ],
        "type": "object"
      },
      "Environment": {
        "properties": {
          "base_branch": {
            "description": "Branch to base work on; None = repo default branch",
            "nullable": true,
            "type": "string"
          },
          "kind": {
            "description": "\"self_hosted\" or \"github_repo\"",
            "type": "string"
          },
          "repo": {
            "description": "Required when kind == \"github_repo\": \"owner/name\"",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "EventFidelity": {
        "description": "How much of a session's event stream may leave the host machine.\n\nStored per workspace in `settings.event_fidelity`; hosts learn the policy\nfrom the claim response and apply it before events are uploaded.",
        "enum": [
          "full",
          "redacted"
        ],
        "type": "string"
      },
      "ExchangeEnrollmentTokenRequest": {
        "properties": {
          "name_prefix": {
            "description": "Prefix for the generated host name; defaults to \"host\".",
            "nullable": true,
            "type": "string"
          },
          "token": {
            "description": "The enrollment secret (`venroll_...`) this host was provisioned with.",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "FinishRequest": {
        "properties": {
          "error": {
            "nullable": true,
            "type": "string"
          },
          "outcome": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionOutcome"
              }
            ],
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "stop_reason": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "FollowUpRequest": {
        "properties": {
          "agent": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Agent"
              }
            ],
            "description": "Agent configuration override; defaults to the parent session's.",
            "nullable": true
          },
          "instructions": {
            "description": "Extra guidance for the agent, appended after the review feedback.",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "HeartbeatResponse": {
        "properties": {
          "cancel_requested": {
            "type": "boolean"
          }
        },
        "required": [
          "cancel_requested"
        ],
        "type": "object"
      },
      "Host": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "ephemeral": {
            "description": "Hosts created by exchanging an enrollment token are ephemeral: the\nserver deletes them once they stop heartbeating. Hosts enrolled by\nhand are not.",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "last_seen_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/WorkspaceId",
            "description": "The workspace this host serves. It only ever claims sessions from\nthe same workspace."
          }
        },
        "required": [
          "id",
          "workspace_id",
          "name",
          "ephemeral",
          "created_at"
        ],
        "type": "object"
      },
      "IssueCredentialRequest": {
        "properties": {
          "provider": {
            "description": "Provider name, e.g. \"github\"",
            "type": "string"
          }
        },
        "required": [
          "provider"
        ],
        "type": "object"
      },
      "IssueCredentialResponse": {
        "properties": {
          "expires_at": {
            "description": "None for non-expiring credentials",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "secret"
        ],
        "type": "object"
      },
      "ListRoutinesResponse": {
        "properties": {
          "routines": {
            "items": {
              "$ref": "#/components/schemas/Routine"
            },
            "type": "array"
          }
        },
        "required": [
          "routines"
        ],
        "type": "object"
      },
      "ListRunsResponse": {
        "properties": {
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "ListSessionsResponse": {
        "properties": {
          "next_cursor": {
            "nullable": true,
            "type": "string"
          },
          "sessions": {
            "items": {
              "$ref": "#/components/schemas/Session"
            },
            "type": "array"
          }
        },
        "required": [
          "sessions"
        ],
        "type": "object"
      },
      "MintEnrollmentTokenRequest": {
        "properties": {
          "max_uses": {
            "description": "Maximum number of hosts this token may enroll; omit for unlimited.",
            "format": "int64",
            "nullable": true,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "MintEnrollmentTokenResponse": {
        "properties": {
          "secret": {
            "description": "The enrollment secret (`venroll_...`). Shown exactly once; store it\nsafely.",
            "type": "string"
          },
          "token": {
            "$ref": "#/components/schemas/EnrollmentToken"
          }
        },
        "required": [
          "token",
          "secret"
        ],
        "type": "object"
      },
      "NewSessionEvent": {
        "properties": {
          "payload": {},
          "seq": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "seq",
          "payload"
        ],
        "type": "object"
      },
      "PrState": {
        "description": "Derived review state of a session's pull request. Reduced from GitHub's\nreview list (see `pr_tracking::reduce`); raw reviews are never stored.",
        "enum": [
          "review_pending",
          "changes_requested",
          "approved",
          "merged",
          "closed",
          "sync_error"
        ],
        "type": "string"
      },
      "PrStatus": {
        "description": "Snapshot of what the PR looks like right now. Transitions between\nsnapshots are appended to the session's event stream as\n`pr_state_changed` / `checks_state_changed` events.",
        "properties": {
          "checks": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ChecksState"
              }
            ],
            "description": "None when the head commit has no check runs.",
            "nullable": true
          },
          "last_synced_at": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/PrState"
          }
        },
        "required": [
          "state",
          "last_synced_at"
        ],
        "type": "object"
      },
      "ReportEventsRequest": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/NewSessionEvent"
            },
            "type": "array"
          }
        },
        "required": [
          "events"
        ],
        "type": "object"
      },
      "Routine": {
        "description": "An API-managed, cron-scheduled session spawn. A background scheduler\nspawns one session per due routine, in the routine's own workspace.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "cron": {
            "description": "Standard 5-field cron expression.",
            "type": "string"
          },
          "enabled": {
            "description": "A disabled routine is never fired; it stays configured so it can be\nresumed without recreating it.",
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "last_fired_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "last_session_id": {
            "nullable": true,
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "next_run_at": {
            "description": "The next UTC instant this routine is due. The scheduler's claim key.",
            "format": "date-time",
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/SessionSpec"
          },
          "timezone": {
            "description": "IANA timezone name (e.g. \"America/New_York\") the cron is interpreted in.",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/WorkspaceId"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "name",
          "cron",
          "timezone",
          "spec",
          "enabled",
          "next_run_at",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "Session": {
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/Agent"
          },
          "cancel_requested": {
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "finished_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "host_id": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "lease_expires_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "outcome": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionOutcome"
              }
            ],
            "nullable": true
          },
          "parent_session_id": {
            "description": "Set on follow-up sessions: the session whose PR this one addresses.\nFollow-ups chain; PR tracking always lives on the root session.",
            "nullable": true,
            "type": "string"
          },
          "pr_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PrStatus"
              }
            ],
            "description": "PR tracking snapshot; only present once the poller has synced a\nsession whose outcome is `pr_opened`.",
            "nullable": true
          },
          "routine_id": {
            "description": "Set on sessions spawned by a routine: the routine that created this\nsession. Lets a routine list the sessions it has spawned.",
            "nullable": true,
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus"
          },
          "stop_reason": {
            "nullable": true,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/WorkspaceId",
            "description": "The workspace this session belongs to. Only hosts enrolled in the\nsame workspace can claim it."
          }
        },
        "required": [
          "id",
          "workspace_id",
          "agent",
          "environment",
          "input",
          "status",
          "cancel_requested",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "SessionEvent": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "payload": {},
          "seq": {
            "format": "int64",
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "seq",
          "payload",
          "created_at"
        ],
        "type": "object"
      },
      "SessionOutcome": {
        "properties": {
          "branch": {
            "nullable": true,
            "type": "string"
          },
          "kind": {
            "description": "\"pr_opened\" | \"pr_updated\" | \"pushed_no_pr\" | \"uncommitted_changes\" | \"no_changes\"\n\n`pr_updated` is reported by follow-up sessions that pushed to the\nexisting branch of a PR opened by an ancestor session.",
            "type": "string"
          },
          "pr_url": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "SessionSpec": {
        "description": "The inline session spec a routine instantiates on each fire. Mirrors the\npublic `CreateSessionRequest` shape exactly (agent + environment + input),\nso when sibling primitives (e.g. deliverable policy) add fields to session\ncreation, routines inherit them without the routine layer knowing.",
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/Agent"
          },
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "input": {
            "type": "string"
          }
        },
        "required": [
          "agent",
          "environment",
          "input"
        ],
        "type": "object"
      },
      "SessionStatus": {
        "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
        ],
        "type": "string"
      },
      "UpdateRoutineRequest": {
        "description": "A partial update: only the `Some` fields change. Mirrors [`UpdateRoutine`].",
        "properties": {
          "cron": {
            "nullable": true,
            "type": "string"
          },
          "enabled": {
            "nullable": true,
            "type": "boolean"
          },
          "name": {
            "nullable": true,
            "type": "string"
          },
          "spec": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionSpec"
              }
            ],
            "nullable": true
          },
          "timezone": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "WorkspaceId": {
        "description": "Identifies the workspace a host or session belongs to.",
        "type": "string"
      }
    },
    "securitySchemes": {
      "api_token": {
        "description": "Static API token for user-facing routes (sessions, host enrollment). Required only when the server sets VISE_API_TOKEN; host-protocol routes use the host's own vhost_ token instead.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API for managing Vise agent sessions",
    "license": {
      "identifier": "MIT OR Apache-2.0",
      "name": "MIT OR Apache-2.0"
    },
    "title": "Vise API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/hosts": {
      "get": {
        "operationId": "list_hosts",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Host"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List all enrolled hosts"
          },
          "401": {
            "description": "Missing or invalid API token"
          }
        },
        "security": [
          {
            "api_token": []
          },
          {}
        ],
        "tags": [
          "hosts"
        ]
      },
      "post": {
        "operationId": "enroll_host",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollHostRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollHostResponse"
                }
              }
            },
            "description": "Host enrolled; the token is returned exactly once"
          },
          "401": {
            "description": "Missing or invalid API token"
          }
        },
        "security": [
          {
            "api_token": []
          },
          {}
        ],
        "tags": [
          "hosts"
        ]
      }
    },
    "/hosts/claim": {
      "post": {
        "operationId": "claim_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                }
              }
            },
            "description": "The claimed session, or null if there is no pending work"
          },
          "401": {
            "description": "Missing or invalid host token"
          }
        },
        "tags": [
          "hosts"
        ]
      }
    },
    "/hosts/enrollment-tokens": {
      "get": {
        "operationId": "list_enrollment_tokens",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EnrollmentToken"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List enrollment tokens (no secrets)"
          },
          "401": {
            "description": "Missing or invalid API token"
          }
        },
        "security": [
          {
            "api_token": []
          },
          {}
        ],
        "tags": [
          "hosts"
        ]
      },
      "post": {
        "operationId": "mint_enrollment_token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MintEnrollmentTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MintEnrollmentTokenResponse"
                }
              }
            },
            "description": "Enrollment token minted; the secret is returned exactly once"
          },
          "401": {
            "description": "Missing or invalid API token"
          },
          "422": {
            "description": "max_uses is not a positive number"
          }
        },
        "security": [
          {
            "api_token": []
          },
          {}
        ],
        "tags": [
          "hosts"
        ]
      }
    },
    "/hosts/enrollment-tokens/{id}/revoke": {
      "post": {
        "operationId": "revoke_enrollment_token",
        "parameters": [
          {
            "description": "Enrollment token ID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentToken"
                }
              }
            },
            "description": "Token revoked (idempotent)"
          },
          "401": {
            "description": "Missing or invalid API token"
