# Copy to `.env` (git-ignored). Used by vise-server at runtime and by
# sqlx-cli / the sqlx query macros at build time when set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vise

# GitHub App used to mint per-repository tokens for hosts and for the
# server-side PR tracker. The App needs: Contents (read/write), Pull requests
# (read/write), Checks (read).
# VISE_GITHUB_APP_ID=123456
# VISE_GITHUB_APP_PRIVATE_KEY_PATH=/path/to/vise.private-key.pem

# Alternative to the App: a GitHub personal access token used as-is for
# hosts and the PR tracker. Use a fine-grained PAT scoped to the repositories
# vise works on, with Contents (read/write), Pull requests (read/write) and
# Actions (read): fine-grained PATs cannot be given Checks, so check runs are
# read through Actions instead. Ignored when the App is configured.
# VISE_GITHUB_PAT=github_pat_...

# Static API token for the user-facing routes (sessions, host enrollment,
# `vise sessions ...` / `vise hosts ...`). When set, those routes require
# `Authorization: Bearer <token>`; `vise` reads the same variable (or
# VISE_API_TOKEN in ~/.vise/.env) to send it. Unset = open, for a single-user
# install on localhost. Hosts keep using their own vhost_ token either way.
# VISE_API_TOKEN=change-me

# PR tracker poll interval in seconds (default 60). Every session that opened
# a PR is polled until the PR merges or closes.
# VISE_PR_POLL_INTERVAL_SECS=60

# How long an ephemeral host (one enrolled by exchanging a venroll_ token,
# `vise host enroll`) may go without heartbeating before the server deletes
# it (default 3600). Hosts still holding a running session wait for the
# lease sweeper first; hand-enrolled hosts are never reaped.
# VISE_EPHEMERAL_HOST_TTL_SECS=3600

# GitHub REST API base (override for GitHub Enterprise or a mock).
# VISE_GITHUB_API_BASE=https://api.github.com
