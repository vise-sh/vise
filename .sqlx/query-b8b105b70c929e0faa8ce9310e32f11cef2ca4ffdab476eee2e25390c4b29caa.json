{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE routines\n            SET next_run_at = $1 + interval '5 minutes'\n            WHERE id IN (\n                SELECT id FROM routines\n                WHERE enabled AND next_run_at <= $1\n                ORDER BY next_run_at\n                LIMIT $2\n                FOR UPDATE SKIP LOCKED\n            )\n            RETURNING\n                id,\n                workspace_id,\n                name,\n                cron,\n                timezone,\n                spec as \"spec: _\",\n                enabled,\n                next_run_at,\n                last_fired_at,\n                last_session_id,\n                created_at,\n                updated_at\n            ",
