  "query": "\n            UPDATE routines\n            SET name = $3,\n                cron = $4,\n                timezone = $5,\n                spec = $6,\n                enabled = $7,\n                next_run_at = $8,\n                updated_at = now()\n            WHERE workspace_id = $1 AND id = $2\n            RETURNING\n                id,\n                workspace_id,\n                name,\n                cron,\n                timezone,\n                spec as \"spec: _\",\n                enabled,\n                next_run_at,\n                last_fired_at,\n                last_session_id,\n                created_at,\n                updated_at\n            ",
