{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT e.session_id, e.seq, e.payload, e.created_at\n            FROM session_events e\n            JOIN sessions s ON s.id = e.session_id\n            WHERE s.workspace_id = $1 AND e.session_id = $2 AND e.seq > $3\n            ORDER BY e.seq\n            LIMIT $4\n            ",
