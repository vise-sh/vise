  "db_name": "PostgreSQL",
  "query": "\n            UPDATE sessions\n            SET status = $3,\n                stop_reason = $4,\n                error = $5,\n                outcome = $6,\n                lease_expires_at = NULL,\n                finished_at = now(),\n                updated_at = now()\n            WHERE id = $2 AND host_id = $1 AND status = 'running'\n            RETURNING\n                id,\n                agent as \"agent: _\",\n                environment as \"environment: _\",\n                input,\n                status,\n                host_id,\n                lease_expires_at,\n                started_at,\n                finished_at,\n                stop_reason,\n                error,\n                outcome as \"outcome: _\",\n                pr_status as \"pr_status: _\",\n                parent_session_id,\n                cancel_requested,\n                created_at,\n                updated_at\n            ",
