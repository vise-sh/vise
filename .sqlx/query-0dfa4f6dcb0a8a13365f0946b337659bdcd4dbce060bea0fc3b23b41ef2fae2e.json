  "query": "\n            UPDATE enrollment_tokens\n            SET uses = uses + 1\n            WHERE token_hash = $1\n              AND revoked_at IS NULL\n              AND (max_uses IS NULL OR uses < max_uses)\n            RETURNING id, workspace_id, max_uses, uses, revoked_at, created_at\n            ",
